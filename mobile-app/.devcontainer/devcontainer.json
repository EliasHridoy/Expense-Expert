{
  "name": "Expense Expert — Flutter",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "FLUTTER_VERSION": "3.32.1",
      "FLUTTER_CHANNEL": "stable"
    }
  },

  // ── Workspace ──────────────────────────────────────────────────────────────
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

  // ── Run as non-root ────────────────────────────────────────────────────────
  "remoteUser": "vscode",

  // ── Environment ───────────────────────────────────────────────────────────
  "remoteEnv": {
    "FLUTTER_HOME": "/opt/flutter",
    "ANDROID_HOME": "/opt/android-sdk",
    "PATH": "/opt/flutter/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:${containerEnv:PATH}"
  },

  // ── Mounts ────────────────────────────────────────────────────────────────
  "mounts": [
    // Persist pub cache between rebuilds (huge speed boost)
    "source=expense-expert-flutter-pub-cache,target=/home/vscode/.pub-cache,type=volume",
    // Persist gradle cache between rebuilds
    "source=expense-expert-flutter-gradle,target=/home/vscode/.gradle,type=volume",
    // Forward host ADB socket so USB-connected physical devices are visible
    "source=/dev/bus/usb,target=/dev/bus/usb,type=bind"
  ],

  // ── USB device access (for ADB physical device) ────────────────────────────
  "runArgs": [
    "--privileged",
    "--network=host"
  ],

  // ── VS Code extensions ─────────────────────────────────────────────────────
  "customizations": {
    "vscode": {
      "extensions": [
        // Flutter & Dart
        "dart-code.flutter",
        "dart-code.dart-code",
        // Firebase
        "toba.vsfire",
        // Productivity
        "usernamehw.errorlens",
        "streetsidesoftware.code-spell-checker",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "pkief.material-icon-theme",
        "formulahendry.code-runner",
        // Formatting
        "esbenp.prettier-vscode"
      ],
      "settings": {
        // Dart / Flutter
        "dart.flutterSdkPath": "/opt/flutter",
        "dart.sdkPath": "/opt/flutter/bin/cache/dart-sdk",
        "[dart]": {
          "editor.formatOnSave": true,
          "editor.rulers": [100],
          "editor.selectionHighlight": false,
          "editor.suggest.snippetsPreventQuickSuggestions": false,
          "editor.suggestSelection": "first",
          "editor.tabCompletion": "onlySnippets",
          "editor.wordBasedSuggestions": "off"
        },
        // Editor
        "editor.formatOnSave": true,
        "editor.fontSize": 14,
        "editor.fontFamily": "'JetBrains Mono', 'Fira Code', monospace",
        "editor.fontLigatures": true,
        "editor.minimap.enabled": false,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        // Terminal
        "terminal.integrated.defaultProfile.linux": "bash",
        // Spell check
        "cSpell.enabledLanguageIds": ["dart", "markdown", "yaml", "json"]
      }
    }
  },

  // ── Lifecycle hooks ────────────────────────────────────────────────────────
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "flutter doctor -v"
}
